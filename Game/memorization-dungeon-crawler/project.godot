; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cogni Crawl"
config/name_localized={
"en": "Cogni Crawl"
}
config/description="A Flashcard Memorization Dungeon Crawler"
config/version="1.2.3"
run/main_scene="uid://cpl08t4hcotn"
config/features=PackedStringArray("4.5", "C#", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/image="uid://7ksq3q1yh5he"
config/icon="uid://d260hqcqu35ev"
config/windows_native_icon="res://assets/icon.ico"
boot_splash/minimum_display_time=400

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Globals="*res://global/GlobalNode.tscn"
LevelsHandler="*res://global/levels/LevelsHandlerNode.tscn"
SaveHandlerGlobal="*res://global/saves/SaveHandlerNode.tscn"
CardsHandlerGlobal="*res://global/cards/CardsHandlerNode.tscn"
DisplayBoot="*res://global/DisplayBoot.tscn"
FileUtilsNode="*res://global/FileUtilsNode.tscn"

[display]

window/size/viewport_height=500
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="MemorizationDungeonCrawler"

[editor_plugins]

enabled=PackedStringArray("res://addons/phantom_camera/plugin.cfg")

[global_group]

player=""
"main menu"=""
level=""
game_loading_panel=""
message_box=""
world_environment=""

