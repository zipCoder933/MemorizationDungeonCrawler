[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Environment"
3d_physics/layer_3="Trigger"
3d_physics/layer_4="Enemy"

[physics]

3d/default_gravity=19.799999999999997
3d/physics_interpolation/scene_traversal="Legacy"

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
scaling_3d/scale=0.8
limits/opengl/max_renderable_lights=16
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
occlusion_culling/use_occlusion_culling=true
